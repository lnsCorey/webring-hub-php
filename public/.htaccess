DirectoryIndex index.php
Options -Indexes

# Security headers for files Apache serves directly (app.js, style.css, icons). index.php sets
# its own. HSTS is only sent over HTTPS; browsers ignore it on plain HTTP anyway.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # Scripts and styles change with every release, but the host adds a 7-day expiry to files it
  # serves directly, so browsers kept an old admin.js for a week and a fix never showed up.
  # Make browsers check each time; an unchanged file answers 304 (a few bytes), so it's cheap.
  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "no-cache"
    Header always unset Expires
  </FilesMatch>
</IfModule>

# Block dotfiles (e.g. .git, .htaccess, .env) even without mod_rewrite
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization header through to PHP under LiteSpeed / FastCGI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Stop rewrite processing once routed to index.php (prevents internal redirect loop)
  RewriteRule ^index\.php$ - [L]

  # Serve existing static assets (style.css, app.js, remove.js, admin.js, icons) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !\.(?:php|html)$ [NC]
  RewriteRule ^ - [L]

  # Route everything else (/, /remove, /admin, /.well-known/did.json, /api/*) through index.php
  RewriteRule . index.php [QSA,L]
</IfModule>
