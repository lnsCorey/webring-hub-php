{
  "id": "arcade",
  "name": "Arcade",
  "version": "1.1.0",
  "apiVersion": 1,
  "class": "WebringHub\\Ext\\Arcade\\ArcadeExtension",
  "description": "A self-hosted arcade of HTML/JavaScript games with DID high scores and play history.",
  "author": "Webring Suite",
  "homepage": "",
  "routes": [
    "GET v1/games",
    "GET v1/games/{slug}",
    "GET v1/games/{slug}/scores",
    "POST v1/games/{slug}/sessions",
    "POST v1/games/{slug}/scores",
    "GET v1/players/{did}/history",
    "GET v1/admin/games",
    "POST v1/admin/games/{slug}/enabled",
    "DELETE v1/admin/players/{did}",
    "DELETE v1/admin/games/{slug}/scores"
  ],
  "events": ["entry.removed", "cron.refresh"],
  "tables": ["games", "scores", "plays", "sessions", "limits"],
  "public": ["/ext/arcade/", "/ext/arcade/games/"],
  "ui": {
    "public": {
      "title": "Arcade",
      "tagline": "Self-hosted HTML5 games with high scores",
      "href": "/ext/arcade/",
      "cta": "Play now",
      "art": "card.svg",
      "accent": "magenta"
    },
    "admin": {
      "panels": [
        {
          "id": "games",
          "title": "Games",
          "type": "table",
          "source": "v1/admin/games",
          "itemsKey": "games",
          "rowKey": "slug",
          "emptyMessage": "No games discovered in extensions/arcade/games/.",
          "columns": [
            { "key": "title", "label": "Game" },
            { "key": "enabled", "label": "Status", "as": "badge" },
            { "key": "version", "label": "Version", "as": "code" },
            { "key": "plays", "label": "Plays" }
          ],
          "actions": [
            {
              "label": "Disable",
              "method": "POST",
              "path": "v1/admin/games/{slug}/enabled",
              "body": { "enabled": false },
              "when": { "key": "enabled", "equals": true },
              "confirm": "Hide this game from players?"
            },
            {
              "label": "Enable",
              "method": "POST",
              "path": "v1/admin/games/{slug}/enabled",
              "body": { "enabled": true },
              "when": { "key": "enabled", "equals": false }
            },
            {
              "label": "Clear scores",
              "method": "DELETE",
              "path": "v1/admin/games/{slug}/scores",
              "style": "danger",
              "confirm": "Delete all high scores and play history for this game?"
            }
          ]
        },
        {
          "id": "remove-player",
          "title": "Remove a player",
          "description": "Deletes all high scores and play history recorded for a player DID.",
          "type": "form",
          "method": "DELETE",
          "path": "v1/admin/players/{did}",
          "submitLabel": "Remove player",
          "confirm": "Delete all arcade scores and play history for this DID?",
          "fields": [
            {
              "name": "did",
              "label": "Player DID",
              "placeholder": "did:web:example.com",
              "required": true
            }
          ]
        }
      ]
    }
  }
}
