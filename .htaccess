Options -Indexes

# Deny dotfiles and backup/config files even if mod_rewrite is disabled
<FilesMatch "(^\.|^config(\.example)?(\s+copy)?\.php$|\.(bak|swp|sql|sqlite|log|sh)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:src|sql|scripts|data|extensions|docs)(?:/|$) - [F,L]
  RewriteRule ^config(?:\.example)?(?:\s+copy)?\.php$ - [F,L]
  RewriteRule ^(?:README\.md|LICENSE|\.gitignore|nginx\.example\.conf)$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>
